---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Una Cara Más — Kova Parker</title>
    <meta name="description" content="Una Cara Más — the debut album by Kova Parker. Out June 4, 2026.">
    <meta name="theme-color" content="#000000">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&display=swap" rel="stylesheet">
    <style>
      * { box-sizing: border-box; }

      html, body {
        margin: 0; padding: 0;
        width: 100%; height: 100%;
        background: #000;
        cursor: none;
        overflow: hidden;
        font-family: monospace;
      }

      .fixed-ui {
        position: fixed;
        top: 0; left: 0; width: 100%;
        padding: 2rem;
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        color: white;
        font-family: monospace;
        text-transform: uppercase;
      }

      .fixed-center {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: 1.2rem;
        font-weight: 900;
      }

      #promo-wrapper {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
      }

      #yt-container {
        width: min(70vw, 120vh);
        aspect-ratio: 16 / 9;
      }

      #yt-container iframe {
        width: 100%;
        height: 100%;
        border: none;
      }

      #custom-cursor {
        position: fixed; top: 0; left: 0;
        width: 8px; height: 8px;
        background: white;
        border-radius: 50%;
        pointer-events: none;
        mix-blend-mode: difference;
        z-index: 10001;
        transform: translate(-50%, -50%);
      }

      #custom-cursor.active { width: 15px; height: 15px; }
    </style>
  </head>
  <body>
    <div class="fixed-ui">
      <div class="fixed-left">
        <div id="phx-block" style="text-align:left;">
          <div id="phx-time">PHX --:--</div>
          <div id="phx-weather" style="font-size:0.8rem; margin-top:4px; white-space:nowrap; overflow:hidden; max-width:180px;">--</div>
        </div>
      </div>
      <div class="fixed-center">KOVA PARKER</div>
      <div class="fixed-right" id="live-clock">-- -- --</div>
    </div>

    <Analytics/>
    <SpeedInsights/>

    <div id="custom-cursor"></div>

    <div id="promo-wrapper">
      <div id="yt-container">
        <iframe
          src="https://www.youtube.com/embed/7vq_ozHRM2w?controls=1&rel=0&modestbranding=1"
          allow="autoplay; encrypted-media; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', () => {

        // Cursor
        const cursor = document.getElementById('custom-cursor');
        document.addEventListener('mousemove', (e) => {
          if (cursor) { cursor.style.left = e.clientX + 'px'; cursor.style.top = e.clientY + 'px'; }
        });
        document.addEventListener('mousedown', () => cursor?.classList.add('active'));
        document.addEventListener('mouseup',   () => cursor?.classList.remove('active'));

        // Clock
        function updateClock() {
          const now = new Date();
          const days = ['SUN','MON','TUE','WED','THU','FRI','SAT'];
          const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
          const clockEl = document.getElementById('live-clock');
          if (clockEl) clockEl.textContent = days[now.getDay()] + ' ' + months[now.getMonth()] + ' ' + String(now.getDate()).padStart(2,'0');
          const phxEl = document.getElementById('phx-time');
          if (phxEl) {
            const phx = new Date(now.toLocaleString('en-US', { timeZone: 'America/Phoenix' }));
            const h = phx.getHours(), m = phx.getMinutes();
            phxEl.textContent = 'PHX ' + String(h % 12 || 12).padStart(2,'0') + ':' + String(m).padStart(2,'0') + ' ' + (h < 12 ? 'AM' : 'PM');
          }
        }
        updateClock();
        setInterval(updateClock, 30000);

        // Weather
        fetch('https://wttr.in/Phoenix?format=j1')
          .then(r => r.json())
          .then(data => {
            const el = document.getElementById('phx-weather');
            if (!el) return;
            const current = data.current_condition?.[0];
            if (!current) return;
            const desc = current.weatherDesc?.[0]?.value ?? '';
            const tempF = current.temp_F ?? '';
            el.textContent = (desc + ' ' + tempF + '°F').trim();
          })
          .catch(() => {});

      });
    </script>
  </body>
</html>
