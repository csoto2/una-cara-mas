---
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Una Cara Más — Kova Parker</title>
    <meta name="description" content="Una Cara Más — the debut album by Kova Parker. Out June 4, 2026.">
    <meta name="theme-color" content="#000000">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=EB+Garamond:wght@400;700&family=Zalando+Sans+Expanded:wght@800&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/images/gemini.avif" type="image/avif" fetchpriority="high">
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <script>
      import { initStarfield } from '../scripts/starfield';
      import { initManuscript } from '../scripts/manuscript';
      (window as any).initStarfield = initStarfield;
      (window as any).initManuscript = initManuscript;
    </script>
    <style>
      /* --- CORE RESET --- */
      * { box-sizing: border-box; }

      /* Keyboard focus ring — only shows for keyboard nav, not mouse clicks */
      :focus-visible {
        outline: 2px solid rgba(255, 255, 255, 0.7);
        outline-offset: 2px;
      }
      .panel-7 :focus-visible {
        outline-color: rgba(0, 0, 0, 0.7);
      }
      
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        font-family: system-ui, -apple-system, sans-serif;
        background-color: #000;
        cursor: none;
        overflow: hidden;
      }

      /* --- THE SNAP ENGINE --- */
      #snap-container {
        position: absolute;
        inset: 0;
        overflow-y: auto;
        overflow-x: hidden;
        scroll-snap-type: y mandatory;
        scroll-behavior: smooth;
        z-index: 100; 
        -webkit-overflow-scrolling: touch;
        pointer-events: auto; /* Scroller must be active to scroll */
      }

      .snap-trigger {
        height: 100vh;
        height: 100dvh;
        width: 100%;
        scroll-snap-align: start;
        scroll-snap-stop: always;
      }

      /* --- THE VISUAL LAYER --- */
      #visual-stack {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100vh;
        z-index: 1;
      }

      .panel {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        will-change: transform;
        transform: translateY(100%);
        padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left);
      }

      /* STACKING ORDER & THEMES */
      .panel-1 { z-index: 1; background: #000; transform: translateY(0%); }
      .panel-2 { z-index: 2; background: #000; }
      .panel-3 { z-index: 3; background: #0a0a0a; color: white; } 
      /* panel-4 removed */
      .panel-5 { z-index: 5; background: #fff; }
      .panel-vinyl { z-index: 6; background: #f5f5f5; }
      .panel-manuscript { z-index: 7; background: #fff; color: #000; }
      .panel-6 { z-index: 8; background: #000; position: relative; }
      .panel-7 { z-index: 9; background: #fff; color: #000; }
      .dust-overlay {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        opacity: 0.15;
        pointer-events: none;
        z-index: 2;
        transform: scale(5);
        transform-origin: center center;
      }
      .panel-6 canvas { position: relative; z-index: 1; background: transparent; }

      /* --- MANUSCRIPT (typewriter) PANEL --- */
      .panel-manuscript {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8vh 6vw;
      }
      .manuscript-page {
        width: 100%;
        max-width: 720px;
      }
      .manuscript-text {
        margin: 0;
        font-family: 'EB Garamond', serif;
        font-size: clamp(1.15rem, 2vw, 1.6rem);
        font-weight: 400;
        line-height: 1.8;
        color: #111;
        white-space: pre-wrap;
        word-break: break-word;
        text-transform: none;
      }
      .manuscript-caret {
        display: inline-block;
        width: 0.6ch;
        height: 1.1em;
        margin-left: 1px;
        background: #111;
        vertical-align: text-bottom;
        animation: manuscript-blink 1s step-end infinite;
      }
      @keyframes manuscript-blink {
        0%, 50% { opacity: 1; }
        50.01%, 100% { opacity: 0; }
      }

      .vinyl-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 0;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        width: 83.33%;
        transition: transform 0.4s ease-out;
      }
      .vinyl-container:hover {
        transform: translate(-50%, -50%) scale(1.05);
      }
      @media (min-width: 1024px) {
        .vinyl-container {
          width: 80vh;
        }
      }
      .vinyl-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        pointer-events: none;
        animation: spin 5s linear infinite;
        will-change: transform; /* Optimize animation */
      }
      /* Removed .vinyl-img.playing faster spin */
      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .gallery-rail {
        display: flex;
        width: 200%;
        height: 100%;
        will-change: transform;
      }

      .gallery-section {
        width: 50%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .panel-bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none; 
      }

      .panel-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .panel-1 .panel-bg img {
        object-fit: contain;
        transform: scale(1);
      }
      .panel-1 .panel-bg img.zoomed {
        animation: heroZoom 20s ease-in-out infinite;
      }

      @keyframes heroZoom {
        from { transform: scale(1); }
        to { transform: scale(var(--target-scale, 1.5)); }
      }

      .panel-bg video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
      }

      .panel-content {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        pointer-events: auto; /* Content needs to be interactive */
      }

      /* --- CAROUSEL --- */
      .carousel-container {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
        touch-action: pan-y; /* Allow vertical scroll, block horizontal browser gestures */
      }

      .carousel-header {
        font-family: system-ui, -apple-system, sans-serif;
        font-weight: 700;
        font-size: 1.2rem; /* Smaller header */
        text-transform: none; /* Sentence case or title case */
        margin-bottom: 2rem;
        text-align: center;
        z-index: 10;
        letter-spacing: 0.02em;
        color: white;
      }

      .carousel-stage {
        position: relative;
        width: 100%;
        height: 68vh;
        display: flex;
        justify-content: center;
        align-items: center;
        perspective: 1000px;
      }

      .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        font-size: 2rem; /* Smaller arrows */
        color: white;
        background: transparent;
        border: none;
        cursor: pointer;
        z-index: 20;
        padding: 1rem;
        opacity: 1; /* Fully visible */
        transition: opacity 0.3s;
        font-family: sans-serif;
        user-select: none;
        pointer-events: auto;
      }
      .nav-arrow:hover { opacity: 0.7; }
      .nav-prev { left: 20%; }
      .nav-next { right: 20%; }

      .carousel-item {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Default center */
        width: 44vw; /* Middle ground size */
        transition: all 1s cubic-bezier(0.25, 1, 0.5, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        cursor: pointer;
        pointer-events: auto;
      }

      /* Modifier classes applied by JS */
      .carousel-item.active {
        z-index: 10;
        opacity: 1;
      }

      .carousel-item.prev {
        z-index: 5;
        opacity: 0.6;
      }

      .carousel-item.next {
        z-index: 5;
        opacity: 0.6;
      }

      .carousel-item.hidden {
        opacity: 0;
        pointer-events: none;
        z-index: 1;
      }
       /* We can calculate specific hidden positions in JS or use generic hidden */

      .poster-media { 
        position: relative; 
        aspect-ratio: 16 / 9; 
        width: 100%;
        overflow: hidden; 
        background: #111;
        pointer-events: auto;
        border: none;
        box-shadow: 0 20px 50px rgba(0,0,0,0.8); /* Darker shadow */
      }

      .poster-media img { 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        pointer-events: none;
      }

      .poster-video { 
        position: absolute; 
        top: 0; 
        left: 0; 
        width: 100%; 
        height: 100%; 
        object-fit: cover; 
        display: none;
        z-index: 10;
        pointer-events: none;
      }

      .poster-video.zoom-130 {
        transform: scale(1.3);
        transform-origin: center center;
      }

      .poster-title {
        margin-top: 2rem;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 0.8rem;
        text-align: center;
        opacity: 0;
        transition: opacity 0.3s;
        color: white;
        text-transform: none; /* Keep natural case for title or minimal caps */
        letter-spacing: 0.02em;
        font-weight: 400;
      }

      .carousel-item.active .poster-title {
        opacity: 1;
      }

      /* "Music video coming soon" placeholder inside a poster */
      .poster-soon {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1.2rem;
        background: linear-gradient(180deg, rgba(17,17,17,0.92), rgba(17,17,17,0.86));
        gap: 0.5rem;
        border-radius: 6px;
      }
      .poster-soon { overflow: hidden; }
      .poster-soon::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: url('/images/gemini.avif');
        background-size: cover;
        background-position: center center;
        transform: scale(1.06);
        filter: grayscale(1) blur(8px) contrast(0.9) brightness(0.6);
        opacity: 0.22;
        z-index: 0;
        pointer-events: none;
      }
      .poster-soon > * { position: relative; z-index: 2; }
      .poster-soon .soon-name {
        font-family: 'EB Garamond', serif;
        font-size: clamp(1.2rem, 2.4vw, 2rem);
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.01em;
        line-height: 1.02;
      }
      .poster-soon .soon-label {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: clamp(0.6rem, 1vw, 0.75rem);
        font-weight: 400;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.5);
      }

      /* Listen Now button inside track boxes */
      .poster-soon .listen-now {
        margin-top: 0.35rem;
        background: transparent;
        color: rgba(255,255,255,0.92);
        border: 1px solid rgba(255,255,255,0.18);
        padding: 0.28rem 0.56rem;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0.02em;
        border-radius: 4px;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.12s ease, background 0.12s ease, opacity 0.12s ease;
        opacity: 0.95;
      }
      .poster-soon .listen-now:hover {
        transform: translateY(-1px);
        background: rgba(255,255,255,0.03);
        opacity: 1;
      }

      .poster-soon { position: absolute; }
      .poster-soon .soon-label {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        bottom: 0.6rem;
        margin: 0;
      }


      .impact {
        font-family: Impact, sans-serif;
        font-weight: 900;
      }

      .zalando {
        font-family: 'Zalando Sans Expanded', sans-serif;
        font-weight: 800;
        letter-spacing: 0.02em;
      }

      .garamond {
        font-family: 'EB Garamond', serif;
        font-weight: 700;
        font-style: normal;
        text-transform: none;
      }


      /* UI ELEMENTS */
      .fixed-ui {
        position: fixed;
        top: 0; left: 0; width: 100%;
        padding: 2rem;
        z-index: 1000;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
        color: white;
        mix-blend-mode: difference;
        font-family: monospace;
        text-transform: uppercase;
      }

      .fixed-ui.panel-1-active {
        mix-blend-mode: normal;
      }

      .fixed-ui.panel-1-active .fixed-center {
        text-shadow: 0 0 10px rgba(0,0,0,0.8);
      }

      .fixed-center { position: absolute; left: 50%; transform: translateX(-50%); font-size: 1.2rem; font-weight: 900; }

      .unmute-button {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.3);
        color: white;
        padding: 1rem 2rem;
        font-size: 0.75rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        cursor: pointer;
        z-index: 200;
        position: fixed;
        bottom: 8vh;
        left: 50%;
        transform: translateX(-50%);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
      }
      .unmute-button.visible { opacity: 1; pointer-events: auto; }

      #custom-cursor {
        position: fixed; top: 0; left: 0;
        width: 8px; height: 8px;
        background: white;
        border-radius: 50%;
        pointer-events: none;
        mix-blend-mode: difference;
        z-index: 10001;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      #custom-cursor.active {
        width: 15px;
        height: 15px;
      }

      #custom-cursor.hand-mode {
        width: 25px;
        height: 25px;
        background: url('/images/white hand vector.svg') no-repeat center;
        background-size: contain;
        border-radius: 0;
      }

      .vinyl-info {
        position: absolute;
        top: 50%;
        right: 18%; /* Closer to vinyl (approx middle of right 1/3) */
        transform: translateY(-50%);
        font-family: 'Courier New', Courier, monospace;
        color: black; /* Assuming vinyl section has light background based on context (white/grey) */
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.5s ease;
        z-index: 10;
      }
      .vinyl-info.visible { opacity: 1; }
      .vinyl-info .album-title { font-weight: bold; text-transform: uppercase; font-size: 0.9rem; }
      .vinyl-info .time-display { font-size: 0.8rem; }

      .hero-title {
        font-size: 1vw;
      }
      .hero-subtitle {
        font-size: 0.75vw;
      }

      .bio-container {
        position: absolute; 
        top: 55%;
        left: 50%; 
        transform: translate(-50%, -50%); 
        display: flex; 
        flex-direction: row; 
        justify-content: center; 
        align-items: center; 
        gap: 5vw;
        width: 100%;
      }

      .bio-item {
        text-align: center;
      }

      .bio-img-wrapper {
        aspect-ratio: 4 / 5;
        width: min(35vw, 60vh);
        overflow: hidden;
      }

      .bio-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .bio-label {
        color: black;
        margin-top: 0.6rem;
        margin-bottom: 0;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.0em;
        text-transform: uppercase;
      }

      /* Theatre expand button — shown only when webpromo is playing */
      #webpromo-theatre-btn {
        display: none;
        position: absolute;
        bottom: 10px;
        right: 10px;
        z-index: 20;
        background: rgba(0,0,0,0.55);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 4px;
        padding: 6px 7px;
        cursor: pointer;
        color: white;
        line-height: 0;
        transition: background 0.2s;
      }
      #webpromo-theatre-btn:hover { background: rgba(0,0,0,0.85); }
      #webpromo-theatre-btn svg { width: 16px; height: 16px; }

      /* Theatre lightbox */
      #webpromo-theatre {
        display: none;
        position: fixed;
        inset: 0;
        background: #000;
        z-index: 10000;
        align-items: center;
        justify-content: center;
      }
      #webpromo-theatre.active { display: flex; }
      #kova-webpromo-theatre {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      #webpromo-theatre-close {
        position: absolute;
        top: 18px;
        right: 22px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.25);
        border-radius: 4px;
        color: white;
        font-size: 1rem;
        width: 36px;
        height: 36px;
        cursor: pointer;
        z-index: 10001;
        transition: background 0.2s;
      }
      #webpromo-theatre-close:hover { background: rgba(255,255,255,0.25); }

      .bio-action {
        color: black;
        margin-top: 0.15rem;
        font-size: 0.7rem;
        font-weight: 400;
        letter-spacing: 0.0em;
        text-transform: uppercase;
      }

      @media (max-width: 768px) {
        .fixed-ui {
          padding: 1rem;
          font-size: 0.6rem;
        }
        .fixed-center {
          font-size: 1rem;
          text-align: center;
          width: 100%;
          position: static;
          transform: none;
          margin-bottom: 0.5rem;
        }
        .fixed-ui {
          flex-direction: column;
          align-items: center;
        }
        .fixed-left, .fixed-right {
          display: none !important;
        }
        #phx-block {
          text-align: center !important;
        }

        .hero-title {
          font-size: 4vw !important;
        }
        .hero-subtitle {
          font-size: 2vw !important;
        }

        .carousel-item {
          width: 55vw;
        }

        .carousel-stage {
          height: 80vh;
        }

        .carousel-header {
          font-size: 0.9rem;
          margin-bottom: 1rem;
        }

        .poster-media {
          aspect-ratio: 9 / 16;
        }

        .poster-title {
          margin-top: 1rem;
          font-size: 0.7rem;
        }

        .bio-container {
          flex-direction: column !important;
          gap: 0 !important;
          top: 0 !important;
          left: 0 !important;
          transform: translateY(0);
          height: 200vh;
          justify-content: flex-start;
          padding-top: 0;
        }
        .bio-item {
          height: 100vh;
          width: 100%;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        }
        .bio-img-wrapper {
          width: 70vw !important;
        }

        .mobile-only-trigger {
          display: block !important;
        }

        .vinyl-info {
          top: auto;
          bottom: 15%;
          right: 50%;
          transform: translateX(50%);
          text-align: center;
          width: 100%;
        }
        
        .vinyl-container {
          width: 90vw;
          max-width: 400px;
        }

        .nav-prev { left: 1%; }
        .nav-next { right: 1%; }

        #custom-cursor {
          display: none !important;
        }
        html, body {
          cursor: auto;
        }
      }

      /* --- FOOTER PANEL --- */
      .footer-inner {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        padding: 6rem 6vw 4vh;
      }

      .footer-columns {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        width: 100%;
        gap: 2rem;
        margin-bottom: 4rem;
      }

      .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .footer-heading {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        margin: 0 0 0.6rem 0;
        color: #000;
      }

      .footer-link {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #000;
        text-decoration: none;
        transition: opacity 0.2s ease;
        cursor: pointer;
      }
      .footer-link:hover { opacity: 0.5; }

      .footer-divider {
        width: 100%;
        height: 1px;
        background: #d0d0d0;
        margin-top: auto;
        margin-bottom: 2rem;
      }

      .footer-bottom {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
        width: 100%;
      }

      .footer-socials {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        gap: 1.6rem;
        align-items: center;
      }

      .social-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #000;
        transition: opacity 0.2s ease;
      }
      .social-icon:hover { opacity: 0.5; }
      .social-icon svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
      }

      .footer-copyright {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 0.65rem;
        font-weight: 400;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #666;
        text-align: center;
        width: 100%;
      }

      .footer-logo {
        width: 80px;
        height: auto;
        display: block;
        margin: auto auto 0;
        opacity: 0.85;
      }

      @media (max-width: 768px) {
        .footer-inner {
          padding: 5rem 5vw 3vh;
        }
        .footer-columns {
          flex-direction: column;
          gap: 2rem;
          margin-bottom: 2.5rem;
        }
        .footer-bottom {
          flex-direction: column;
