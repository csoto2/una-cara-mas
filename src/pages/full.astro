   <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 0. HERO ZOOM LOGIC
      const heroImg = document.getElementById('hero-img') as HTMLImageElement | null;
      if (heroImg) {
        const startZoom = () => {
          const winW = window.innerWidth;
          const winH = window.innerHeight;
          const imgW = heroImg.naturalWidth;
          const imgH = heroImg.naturalHeight;

          if (imgW && imgH) {
            // Calculate scale to go from 'contain' to 'cover'
            const scaleX = winW / imgW;
            const scaleY = winH / imgH;
            
            // contain scale is min(scaleX, scaleY)
            // cover scale is max(scaleX, scaleY)
            const targetScale = Math.max(scaleX, scaleY) / Math.min(scaleX, scaleY);
            
            heroImg.style.setProperty('--target-scale', targetScale.toString());
            // Force reflow
            void heroImg.offsetWidth;
            heroImg.classList.add('zoomed');
          }
        };

        if (heroImg.complete) startZoom();
        else heroImg.addEventListener('load', startZoom);

        window.addEventListener('resize', startZoom);
      }

      const scroller = document.getElementById('snap-container') as HTMLElement | null;
      // panels array is no longer used for strict loop logic, but kept for element refs if needed
      // const panels = ... 
      
      const cursor = document.getElementById('custom-cursor') as HTMLElement | null;
      const promoVideo = document.getElementById('promo-video') as HTMLVideoElement | null;
      const unmuteBtn = document.getElementById('unmute-button') as HTMLButtonElement | null;
      const fixedUi = document.querySelector('.fixed-ui');
      const galleryRail = document.getElementById('gallery-rail');

      // --- HLS SETUP for promo video ---
      const promoHlsSrc = 'https://d2a01uidrlfe3n.cloudfront.net/videos/hls/promo/promo.m3u8';
      if (promoVideo) {
        if ((window as any).Hls && (window as any).Hls.isSupported()) {
          const hls = new (window as any).Hls();
          hls.loadSource(promoHlsSrc);
          hls.attachMedia(promoVideo);
        } else if (promoVideo.canPlayType('application/vnd.apple.mpegurl')) {
          promoVideo.src = promoHlsSrc;
        } else {
          promoVideo.src = 'https://d2a01uidrlfe3n.cloudfront.net/videos/promo.mp4';
        }
      }
      
      const p2 = document.getElementById('p2');
      const p3 = document.getElementById('p3');
      const p5 = document.getElementById('p5');
      const pVinyl = document.getElementById('p-vinyl');
      const pManuscript = document.getElementById('p-manuscript');
      const p6 = document.getElementById('p6');
      const p7 = document.getElementById('p7');

      // Manuscript typewriter controller (starts when panel scrolls into view)
      const manuscriptCtrl = typeof (window as any).initManuscript === 'function'
        ? (window as any).initManuscript('manuscript-text')
        : null;

      // Moved from bottom to be available in renderLoop
      const documentaryImage = document.getElementById('documentary-image');
      const documentaryOverlay = documentaryImage?.querySelector('.documentary-overlay') as HTMLElement | null;

      const promoImage = document.getElementById('promo-image');
      const kovaWebpromo = document.getElementById('kova-webpromo') as HTMLVideoElement | null;

      // --- HLS SETUP for webpromo video ---
      const webpromoHlsSrc = 'https://d2a01uidrlfe3n.cloudfront.net/videos/hls/webpromo/webpromo.m3u8';
      let webpromoHls: any = null;
      function initWebpromoHls() {
        if (!kovaWebpromo) return;
        if ((window as any).Hls && (window as any).Hls.isSupported()) {
          if (webpromoHls) { webpromoHls.destroy(); }
          webpromoHls = new (window as any).Hls();
          webpromoHls.loadSource(webpromoHlsSrc);
          webpromoHls.attachMedia(kovaWebpromo);
        } else if (kovaWebpromo.canPlayType('application/vnd.apple.mpegurl')) {
          kovaWebpromo.src = webpromoHlsSrc;
        } else {
          kovaWebpromo.src = webpromoHlsSrc;
        }
      }

      if (kovaWebpromo) {
        kovaWebpromo.addEventListener('ended', () => {
          kovaWebpromo.style.display = 'none';
          const webpromoBg = document.getElementById('webpromo-bg');
          if (webpromoBg) webpromoBg.style.display = 'none';
          const theatreBtn = document.getElementById('webpromo-theatre-btn');
          if (theatreBtn) theatreBtn.style.display = 'none';
        });
      }

      // --- THEATRE MODE ---
      const theatreBtn = document.getElementById('webpromo-theatre-btn');
      const theatreOverlay = document.getElementById('webpromo-theatre');
      const theatreVideo = document.getElementById('kova-webpromo-theatre') as HTMLVideoElement | null;
      const theatreClose = document.getElementById('webpromo-theatre-close');
      let theatreHls: any = null;

      function openTheatre() {
        if (!theatreOverlay || !theatreVideo || !kovaWebpromo) return;
        const currentTime = kovaWebpromo.currentTime;

        // Init HLS on the theatre video
        if ((window as any).Hls && (window as any).Hls.isSupported()) {
          if (theatreHls) theatreHls.destroy();
          theatreHls = new (window as any).Hls();
          theatreHls.loadSource(webpromoHlsSrc);
          theatreHls.attachMedia(theatreVideo);
          theatreHls.on((window as any).Hls.Events.MANIFEST_PARSED, () => {
            theatreVideo.currentTime = currentTime;
            theatreVideo.play();
          });
        } else {
          theatreVideo.src = webpromoHlsSrc;
          theatreVideo.currentTime = currentTime;
          theatreVideo.play();
        }

        // Pause the small player
        kovaWebpromo.pause();
        theatreOverlay.classList.add('active');

        // Block snap scroll while theatre is open
        const snapContainer = document.getElementById('snap-container');
        if (snapContainer) snapContainer.style.overflow = 'hidden';
      }

      function closeTheatre(returnToSmall = true) {
        if (!theatreOverlay || !theatreVideo || !kovaWebpromo) return;
        const syncTime = theatreVideo.currentTime;
        theatreVideo.pause();
        if (theatreHls) { theatreHls.destroy(); theatreHls = null; }
        theatreVideo.src = '';
        theatreOverlay.classList.remove('active');

        const snapContainer = document.getElementById('snap-container');
        if (snapContainer) snapContainer.style.overflow = '';

        if (returnToSmall) {
          // Sync time back to small player but don't autoplay
          kovaWebpromo.currentTime = syncTime;
          // Leave small player paused — user can click to resume
        }
      }

      // Click video to play/pause in theatre
      theatreVideo?.addEventListener('click', () => {
        if (!theatreVideo) return;
        if (theatreVideo.paused) theatreVideo.play();
        else theatreVideo.pause();
      });

      // When theatre video ends — close theatre, don't autoplay small player
      theatreVideo?.addEventListener('ended', () => {
        closeTheatre(false);
        // Reset small player to beginning, hidden
        if (kovaWebpromo) {
          kovaWebpromo.currentTime = 0;
          kovaWebpromo.pause();
          kovaWebpromo.style.display = 'none';
          const webpromoBg = document.getElementById('webpromo-bg');
          if (webpromoBg) webpromoBg.style.display = 'none';
          const tBtn = document.getElementById('webpromo-theatre-btn');
          if (tBtn) tBtn.style.display = 'none';
        }
      });

      theatreClose?.addEventListener('click', () => closeTheatre());
      // ESC to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && theatreOverlay?.classList.contains('active')) closeTheatre();
      });
      // Click backdrop (not video) to close
      theatreOverlay?.addEventListener('click', (e) => {
        if (e.target === theatreOverlay) closeTheatre();
      });

      const vinylContainer = document.getElementById('vinyl-container');
      const vinylAudio = document.getElementById('vinyl-audio') as HTMLAudioElement | null;
      const vinylImg = vinylContainer?.querySelector('.vinyl-img') as HTMLElement | null;
      const vinylInfo = document.getElementById('vinyl-info');
      const timeDisplay = document.getElementById('time-display');

      // --- CAROUSEL LOGIC ---
      const carouselItems = document.querySelectorAll('.carousel-item');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      let currentIndex = 0;

      function updateCarousel() {
        const total = carouselItems.length;
        const offsetVw = window.innerWidth < 768 ? 65 : 55;
        carouselItems.forEach((item, index) => {
          const offset = index - currentIndex;
          const scale = index === currentIndex ? 1.1 : 0.85;
          // Simple movement: straight forward slide with scale for active item
          (item as HTMLElement).style.transform = `translate(calc(-50% + ${offset * offsetVw}vw), -50%) scale(${scale})`;
          
          item.className = 'carousel-item'; // Reset
          
          if (index === currentIndex) {
            item.classList.add('active');
            togglePosterVideo(item as HTMLElement, true);
          } else if (index === currentIndex - 1) {
            item.classList.add('prev');
            togglePosterVideo(item as HTMLElement, false);
          } else if (index === currentIndex + 1) {
            item.classList.add('next');
            togglePosterVideo(item as HTMLElement, false);
          } else {
            item.classList.add('hidden');
            togglePosterVideo(item as HTMLElement, false);
          }
        });

        // Hide buttons at ends
        if (prevBtn) prevBtn.style.opacity = currentIndex === 0 ? '0' : '1';
        if (prevBtn) (prevBtn as HTMLElement).style.pointerEvents = currentIndex === 0 ? 'none' : 'auto';
        if (nextBtn) nextBtn.style.opacity = currentIndex === total - 1 ? '0' : '1';
        if (nextBtn) (nextBtn as HTMLElement).style.pointerEvents = currentIndex === total - 1 ? 'none' : 'auto';
      }

      if (carouselItems.length > 0) {
        updateCarousel();
        window.addEventListener('resize', updateCarousel);
        
        const showNext = () => {
          if (currentIndex < carouselItems.length - 1) {
            currentIndex++;
            updateCarousel();
          }
        };

        const showPrev = () => {
          if (currentIndex > 0) {
            currentIndex--;
            updateCarousel();
          }
        };

        if (nextBtn) nextBtn.addEventListener('click', showNext);
        if (prevBtn) prevBtn.addEventListener('click', showPrev);

        document.addEventListener('keydown', (e) => {
          if (!scroller) return;
          const st = scroller.scrollTop;
          const vh = window.innerHeight;

          // Left/Right: carousel navigation when on Panel 3
          if (st > vh * 1.5 && st < vh * 2.5) {
            if (e.key === 'ArrowRight') { showNext(); return; }
            if (e.key === 'ArrowLeft') { showPrev(); return; }
          }

          // Up/Down: panel-to-panel navigation
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            const triggers = scroller.querySelectorAll('.snap-trigger');
            const totalPanels = Array.from(triggers).filter(
              t => getComputedStyle(t).display !== 'none'
            ).length;
            const currentPanel = Math.round(st / vh);
            let targetPanel = currentPanel;
            if (e.key === 'ArrowDown' && currentPanel < totalPanels - 1) {
              targetPanel = currentPanel + 1;
            } else if (e.key === 'ArrowUp' && currentPanel > 0) {
              targetPanel = currentPanel - 1;
            }
            if (targetPanel !== currentPanel) {
              scroller.scrollTo({ top: targetPanel * vh, behavior: 'smooth' });
            }
          }
        });

        // Add manual click handling for carousel buttons through the scroller overlay
        scroller?.addEventListener('click', (e) => {
             const x = e.clientX; 
             const y = e.clientY;
             scroller.style.pointerEvents = 'none';
             const hit = document.elementFromPoint(x, y);
             scroller.style.pointerEvents = 'auto';
             
             if (hit) {
               if (hit.closest('#prev-btn')) showPrev();
               if (hit.closest('#next-btn')) showNext();
               if (hit.closest('.listen-now')) {
                 const a = hit.closest('.listen-now') as HTMLAnchorElement | null;
                 if (a) a.click();
               }
             }
        });

        // --- SWIPE / DRAG / WHEEL LOGIC ---
        // Direction-locking touch handler for carousel panel.
        // When on Panel 3 and the user starts a horizontal gesture,
        // we preventDefault on touchmove to kill the vertical scroll entirely.
        // This keeps scroll-snap-type: y mandatory working perfectly on all panels
        // while preventing accidental panel changes during horizontal swipes.

        let startX = 0;
        let startY = 0;
        let startTime = 0;
        let lockedAxis: 'none' | 'horizontal' | 'vertical' = 'none';
        const LOCK_THRESHOLD = 8; // px before we decide direction

        function isOnCarouselPanel(): boolean {
          if (!scroller) return false;
          const st = scroller.scrollTop;
          const vh = window.innerHeight;
          return st > vh * 1.5 && st < vh * 2.5;
        }

        scroller?.addEventListener('touchstart', (e) => {
          const t = e.touches[0];
          startX = t.clientX;
          startY = t.clientY;
          startTime = Date.now();
          lockedAxis = 'none';
        }, { passive: true });

        // NON-PASSIVE so we can preventDefault to block vertical scroll
        // when a horizontal swipe is detected on the carousel panel.
        scroller?.addEventListener('touchmove', (e) => {
          // Only intervene on the carousel panel
          if (!isOnCarouselPanel()) return;

          const t = e.touches[0];
          const dx = Math.abs(t.clientX - startX);
          const dy = Math.abs(t.clientY - startY);

          // Wait until we've moved past the threshold to decide
          if (lockedAxis === 'none') {
            if (dx < LOCK_THRESHOLD && dy < LOCK_THRESHOLD) return;
            // Decide: if horizontal component wins, lock horizontal
            lockedAxis = dx > dy ? 'horizontal' : 'vertical';
          }

          // If locked horizontal, eat the vertical scroll entirely
          if (lockedAxis === 'horizontal') {
            e.preventDefault();
          }
          // If locked vertical, do nothing — browser scrolls normally
        }, { passive: false });

        scroller?.addEventListener('touchend', (e) => {
          const t = e.changedTouches[0];
          const dx = t.clientX - startX;
          const dy = t.clientY - startY;
          const dt = Date.now() - startTime;

          // Advance carousel if we were locked horizontal and the swipe is meaningful
          if (lockedAxis === 'horizontal' && isOnCarouselPanel() &&
              dt < 800 && Math.abs(dx) > 25) {
            if (dx < 0) showNext();
            else showPrev();
          }
          lockedAxis = 'none';
        }, { passive: true });

        // Desktop pointer fallback (mouse drag)
        scroller?.addEventListener('pointerdown', (e) => {
          if (e.pointerType === 'touch') return;
          startX = e.clientX;
          startY = e.clientY;
          startTime = Date.now();
        }, { passive: true });

        scroller?.addEventListener('pointerup', (e) => {
          if (e.pointerType === 'touch') return;
          const dx = e.clientX - startX;
          const dy = e.clientY - startY;
          const dt = Date.now() - startTime;

          if (dt < 500 && Math.abs(dx) > 30 && Math.abs(dx) > Math.abs(dy)) {
            if (isOnCarouselPanel()) {
              if (dx < 0) showNext();
              else showPrev();
            }
          }
        }, { passive: true });

        // Wheel support (Trackpad horizontal swipe)
        let lastWheelTime = 0;
        scroller?.addEventListener('wheel', (e) => {
          // If moving horizontally more than vertically
          if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
            const st = scroller.scrollTop;
            const vh = window.innerHeight;
            if (st > vh * 1.5 && st < vh * 2.5) {
              const now = Date.now();
              if (now - lastWheelTime < 400) return; // Debounce

              if (Math.abs(e.deltaX) > 10) {
                if (e.deltaX > 0) showNext();
                else showPrev();
                lastWheelTime = now;
              }
            }
          }
        }, { passive: true });
      }
      
      let mx = 0, my = 0, cx = 0, cy = 0;
      let lastHoveredMedia: HTMLElement | null = null;
      let lastScrollTop = -1;
      let tick = 0;

      // Initialize panel-1-active state
      fixedUi?.classList.add('panel-1-active');

      // 1. TRACK MOUSE (Optimized: Removed heavy logic)
      document.addEventListener('mousemove', (e) => {
        mx = e.clientX;
        my = e.clientY;
      });

      function togglePosterVideo(container: HTMLElement, play: boolean) {
        const v = container.querySelector('.poster-video') as HTMLVideoElement | null;
        if (!v) return;
        if (play) {
          v.style.display = 'block';
          v.currentTime = 0;
          v.play().catch(() => {});
        } else {
          v.pause();
          v.style.display = 'none';
        }
      }

      // 2. MASTER RENDER LOOP (Handles Scroll & Cursor & Hover)
      function renderLoop() {
        requestAnimationFrame(renderLoop);

        // A. CURSOR INTERPOLATION
        if (cursor) {
          cx += (mx - cx) * 0.15;
          cy += (my - cy) * 0.15;
          cursor.style.transform = `translate(${cx}px, ${cy}px) translate(-50%, -50%)`;
        }
        
        // B. SCROLL & ANIMATION LOGIC
        if (scroller) {
          const scrollTop = scroller.scrollTop;
          
          // Only update if scroll changed or first run
          if (Math.abs(scrollTop - lastScrollTop) > 0.5 || lastScrollTop === -1) {
            lastScrollTop = scrollTop;
            const vh = window.innerHeight;

            // --- UI STATES ---
            if (scrollTop < vh) {
              if (!fixedUi?.classList.contains('panel-1-active')) fixedUi?.classList.add('panel-1-active');
            } else {
              if (fixedUi?.classList.contains('panel-1-active')) fixedUi?.classList.remove('panel-1-active');
            }

            // --- PANEL ANIMATION LOGIC ---
            // Range 0 -> 1vh : Panel 2 enters over Panel 1
            if (p2) {
              const start = 0; const end = vh;
              if (scrollTop <= start) p2.style.transform = `translateY(100%)`;
              else if (scrollTop >= end) p2.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - start) / vh;
                p2.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            // Range 1vh -> 2vh : Panel 3 enters over Panel 2
            if (p3) {
              const start = vh; const end = 2 * vh;
              if (scrollTop <= start) p3.style.transform = `translateY(100%)`;
              else if (scrollTop >= end) p3.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - start) / vh;
                p3.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }



            // Range 2vh -> 3vh : Panel 5 enters over Panel 3
            if (p5) {
              const start = 2 * vh; const end = 3 * vh;
              if (scrollTop <= start) p5.style.transform = `translateY(100%)`;
              else if (scrollTop >= end) p5.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - start) / vh;
                p5.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            // Range 3vh -> 4vh (or 4vh -> 5vh on mobile) : Panel Vinyl enters over Panel 5
            const isMobile = window.innerWidth <= 768;
            const vinylStart = isMobile ? 4 * vh : 3 * vh;
            const vinylEnd = isMobile ? 5 * vh : 4 * vh;
            
            if (isMobile && p5) {
              // On mobile, Panel 5 scrolls internally for 1vh
              const bioContainer = p5.querySelector('.bio-container') as HTMLElement;
              if (bioContainer) {
                if (scrollTop > 3 * vh && scrollTop < 4 * vh) {
                  const p = (scrollTop - 3 * vh) / vh;
                  bioContainer.style.transform = `translateY(-${p * 100}vh)`;
                } else if (scrollTop <= 3 * vh) {
                  bioContainer.style.transform = `translateY(0)`;
                } else {
                  bioContainer.style.transform = `translateY(-100vh)`;
                }
              }
            } else if (p5) {
              const bioContainer = p5.querySelector('.bio-container') as HTMLElement;
              if (bioContainer) {
                 bioContainer.style.transform = `translate(-50%, -50%)`;
              }
            }

            if (pVinyl) {
              if (scrollTop <= vinylStart) pVinyl.style.transform = `translateY(100%)`;
              else if (scrollTop >= vinylEnd) pVinyl.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - vinylStart) / vh;
                pVinyl.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            // Range 4vh -> 5vh (or 5vh -> 6vh on mobile) : Manuscript enters over Panel Vinyl
            const manuscriptStart = isMobile ? 5 * vh : 4 * vh;
            const manuscriptEnd = isMobile ? 6 * vh : 5 * vh;
            if (pManuscript) {
              if (scrollTop <= manuscriptStart) pManuscript.style.transform = `translateY(100%)`;
              else if (scrollTop >= manuscriptEnd) pManuscript.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - manuscriptStart) / vh;
                pManuscript.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            // Start typing once the manuscript panel is essentially in view,
            // and pause/resume as the user scrolls off and back onto the panel.
            if (manuscriptCtrl) {
              const manuscriptInView =
                scrollTop >= manuscriptStart + vh * 0.4 &&
                scrollTop < manuscriptEnd + vh * 0.5;
              if (manuscriptInView) {
                manuscriptCtrl.start();
                manuscriptCtrl.resume();
              } else {
                manuscriptCtrl.pause();
              }
            }

            // Range 5vh -> 6vh (or 6vh -> 7vh on mobile) : Panel 6 enters over Manuscript
            const p6Start = isMobile ? 6 * vh : 5 * vh;
            const p6End = isMobile ? 7 * vh : 6 * vh;
            if (p6) {
              if (scrollTop <= p6Start) p6.style.transform = `translateY(100%)`;
              else if (scrollTop >= p6End) p6.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - p6Start) / vh;
                p6.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            // Range 6vh -> 7vh (or 7vh -> 8vh on mobile) : Panel 7 (Footer) enters over Panel 6
            const p7Start = isMobile ? 7 * vh : 6 * vh;
            const p7End = isMobile ? 8 * vh : 7 * vh;
            if (p7) {
              if (scrollTop <= p7Start) p7.style.transform = `translateY(100%)`;
              else if (scrollTop >= p7End) p7.style.transform = `translateY(0%)`;
              else {
                const p = (scrollTop - p7Start) / vh;
                p7.style.transform = `translateY(${100 - (p * 100)}%)`;
              }
            }

            const isPromoVisible = scrollTop >= vh - 100 && scrollTop < vh * 2 - 100;
            if (isPromoVisible) {
              if (promoVideo && promoVideo.paused) promoVideo.play().catch(() => {});
              if (unmuteBtn && document.body.contains(unmuteBtn)) unmuteBtn.classList.add('visible');

               // NEW: Auto-pause vinyl if promo video is playing and not muted
              if (promoVideo && !promoVideo.muted && vinylAudio && !vinylAudio.paused) {
                vinylAudio.pause();
                if (vinylImg) vinylImg.classList.remove('playing');
                // We'll set a flag so we can resume it if needed, or user can resume manually.
                (vinylAudio as any)._autoPaused = true;
              }
            } else {
              if (promoVideo && !promoVideo.paused) promoVideo.pause();
              if (unmuteBtn) unmuteBtn.classList.remove('visible');

              // NEW: Auto-resume vinyl if we paused it automatically
              if (vinylAudio && (vinylAudio as any)._autoPaused) {
                 vinylAudio.play().then(() => {
                   if (vinylImg) vinylImg.classList.add('playing');
                   // Note: vinylInfo should have stayed visible so that's fine.
                 }).catch(() => {});
                 (vinylAudio as any)._autoPaused = false;
              }
            }

            // Pause webpromo video when panel 5 is not visible
            const isBioVisible = scrollTop >= 2 * vh - 100 && scrollTop < vinylEnd - 100;
            if (kovaWebpromo && !kovaWebpromo.paused && !isBioVisible) {
              kovaWebpromo.pause();
            }
          }
        }

        // C. HOVER DETECTION (Throttled)
        // Check every 6 frames (approx 10 times per second @ 60fps)
        tick++;
        if (tick % 6 === 0 && scroller) {
          // Only check if we are interacting with the gallery (roughly scrolled past 0.5 screen height)
          if (lastScrollTop > window.innerHeight * 0.5) {
             scroller.style.pointerEvents = 'none';
             const hoveredElement = document.elementFromPoint(mx, my);
             scroller.style.pointerEvents = 'auto'; // This toggle is expensive, hence throttling

             const posterMedia = hoveredElement?.closest('.poster-media') as HTMLElement | null;
             const overDocImg = hoveredElement?.closest('#documentary-image') as HTMLElement | null;
             const overPromoImg = hoveredElement?.closest('#promo-image') as HTMLElement | null;
             const overStarfield = hoveredElement?.closest('#starfield') as HTMLElement | null;
             const overArrow = hoveredElement?.closest('.nav-arrow') as HTMLElement | null;
             const overVinyl = hoveredElement?.closest('.vinyl-container') as HTMLElement | null;
             const overFooterLink = hoveredElement?.closest('.footer-link') as HTMLElement | null;
             const overSocialIcon = hoveredElement?.closest('.social-icon') as HTMLElement | null;
             const overTheatreBtn = hoveredElement?.closest('#webpromo-theatre-btn') as HTMLElement | null;
             const overLangBtn = hoveredElement?.closest('#ms-lang-btn') as HTMLElement | null;
             const overListenNow = hoveredElement?.closest('.listen-now') as HTMLElement | null;

             if (cursor) {
               if (overArrow || overDocImg || overVinyl || overPromoImg || overFooterLink || overSocialIcon || overTheatreBtn || overLangBtn || overListenNow) {
                 cursor.classList.add('hand-mode');
                 cursor.classList.remove('active');
               } else if (overStarfield) {
                 cursor.classList.add('active');
                 cursor.classList.remove('hand-mode');
               } else {
                 cursor.classList.remove('active');
                 cursor.classList.remove('hand-mode');
               }
             }

             // Visual feedback for the documentary image itself
             if (overDocImg) {
               overDocImg.style.transform = 'scale(1.02)';
               overDocImg.style.transition = 'transform 0.3s ease';
             } else {
               const allDocImgs = document.querySelectorAll('#documentary-image');
               allDocImgs.forEach(el => (el as HTMLElement).style.transform = 'scale(1)');
             }

             // Visual feedback for the promo image
             if (overPromoImg) {
               overPromoImg.style.transform = 'scale(1.02)';
               overPromoImg.style.transition = 'transform 0.3s ease';
             } else {
               const allPromoImgs = document.querySelectorAll('#promo-image');
               allPromoImgs.forEach(el => (el as HTMLElement).style.transform = 'scale(1)');
             }
          }
        }
      }
      renderLoop();

      // 4. UNMUTE LOGIC
      // When user clicks UNMUTE we want the button to disappear and keep the video unmuted.
      unmuteBtn?.addEventListener('click', () => {
        if (promoVideo && unmuteBtn) {
          // Force unmute
          promoVideo.muted = false;

          // NEW: If we just unmuted the promo video, and vinyl is playing, pause vinyl
          // This covers the case where the user is already on Panel 2 watching muted video
          // while listening to vinyl, then clicks unmute.
          if (vinylAudio && !vinylAudio.paused) {
             vinylAudio.pause();
             if (vinylImg) vinylImg.classList.remove('playing');
             (vinylAudio as any)._autoPaused = true;
          }

          // Hide visually (fade) then remove from DOM so it can't reappear on scroll
          unmuteBtn.classList.remove('visible');
          unmuteBtn.style.transition = 'opacity 0.3s ease';
          unmuteBtn.style.opacity = '0';
          setTimeout(() => {
            try { unmuteBtn.remove(); } catch (e) { /* ignore */ }
          }, 300);
        }
      });

      // 5. CLOCK & WEATHER UPDATER (PHX)
      function getWeatherDescription(code: number) {
        // Map Open-Meteo weather codes to human-friendly text
        if (code === 0) return 'Clear';
        if (code === 1 || code === 2 || code === 3) return 'Partly cloudy';
        if (code === 45 || code === 48) return 'Fog';
        if (code === 51 || code === 53 || code === 55) return 'Drizzle';
        if (code === 56 || code === 57) return 'Freezing drizzle';
        if (code === 61 || code === 63 || code === 65) return 'Rain';
        if (code === 66 || code === 67) return 'Freezing rain';
        if (code === 71 || code === 73 || code === 75) return 'Snow';
        if (code === 77) return 'Snow grains';
        if (code === 80 || code === 81 || code === 82) return 'Showers';
        if (code === 85 || code === 86) return 'Snow showers';
        if (code === 95 || code === 96 || code === 99) return 'Thunderstorm';
        return 'Unknown';
      }

      async function fetchPhxWeather() {
        const phxWeatherEl = document.getElementById('phx-weather');
        try {
          // Phoenix, AZ coordinates
          const lat = 33.4484; const lon = -112.0740;
          const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&timezone=America/Phoenix`;
          const res = await fetch(url);
          if (!res.ok) throw new Error('weather fetch failed');
          const data = await res.json();
          const cw = data.current_weather;
          if (cw && typeof cw.temperature === 'number') {
            const c = cw.temperature; // Celsius
            const f = Math.round((c * 9) / 5 + 32);
            const desc = getWeatherDescription(cw.weathercode);
            if (phxWeatherEl) phxWeatherEl.innerText = `${f}°F · ${desc}`;
          } else {
            if (phxWeatherEl) phxWeatherEl.innerText = `—`;
          }
        } catch (e) {
          if (phxWeatherEl) phxWeatherEl.innerText = `—`;
        }
      }

      function updateClock() {
        const now = new Date();
        const fmt: Intl.DateTimeFormatOptions = { hour: '2-digit', minute: '2-digit', hour12: false };
        const phxTime = document.getElementById('phx-time');
        const liveClock = document.getElementById('live-clock');

        if (phxTime) {
          phxTime.innerText = "PHX, AZ " + now.toLocaleTimeString('en-US', { ...fmt, timeZone: 'America/Phoenix' });
        }
        if (liveClock) {
          const months = ["JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"];
          liveClock.innerText = `${months[now.getMonth()]} ${now.getDate()} ${now.getFullYear()} ${now.getHours()}:${now.getMinutes().toString().padStart(2,'0')}`;
        }
      }

      // Refresh clock every second and weather every 10 minutes
      setInterval(updateClock, 1000); updateClock();
      fetchPhxWeather();
      setInterval(fetchPhxWeather, 10 * 60 * 1000);

      // 6. DOCUMENTARY IMAGE & VINYL CLICK HANDLERS
      // Variables moved to top scope...

      function formatTime(s: number) {
        if (!s || isNaN(s)) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${m}:${sec.toString().padStart(2, '0')}`;
      }
      
      // Handle Vinyl Click directly (if possible, though scroller usually blocks it)
      if (vinylContainer && vinylAudio && vinylImg) {
        vinylContainer.addEventListener('click', () => {
          if (vinylAudio.paused) {
            vinylAudio.play().then(() => {
              vinylImg.classList.add('playing');
              vinylInfo?.classList.add('visible'); // Show info on play
            }).catch(e => console.error("Audio playback failed", e));
          } else {
            vinylAudio.pause();
            vinylImg.classList.remove('playing');
            // Info stays visible on pause
          }
        });

        vinylAudio.addEventListener('timeupdate', () => {
           if (timeDisplay) {
             const cur = vinylAudio.currentTime;
             const dur = vinylAudio.duration;
             timeDisplay.innerText = `${formatTime(cur)} / ${formatTime(dur)}`;
           }
        });

        vinylAudio.addEventListener('ended', () => {
          vinylImg.classList.remove('playing');
          vinylAudio.currentTime = 0; 
          vinylInfo?.classList.remove('visible'); // Hide on end
        });
      }

      // Handle Clicks via Scroller Overlay
      scroller?.addEventListener('click', (e) => {
        // Use the same trick as hover detection to see what's under the scroller
        scroller.style.pointerEvents = 'none';
        const hit = document.elementFromPoint(mx, my);
        scroller.style.pointerEvents = 'auto';
        
        // A. Documentary Logic
        if (hit && documentaryImage && documentaryOverlay && documentaryImage.contains(hit)) {
          const isVisible = documentaryOverlay.style.opacity === '1';
          documentaryOverlay.style.opacity = isVisible ? '0' : '1';
        }

        // A2. Promo Image Video Logic - Disabled videolayer; keeping it a standard picture
        /*
        if (hit && promoImage && kovaWebpromo && promoImage.contains(hit)) {
          const webpromoBg = document.getElementById('webpromo-bg');
          const tBtn = document.getElementById('webpromo-theatre-btn');

          // If the theatre expand button was clicked, open theatre — don't toggle play
          if (hit.closest('#webpromo-theatre-btn')) {
            openTheatre();
          } else if (kovaWebpromo.style.display === 'none' || !kovaWebpromo.style.display) {
            initWebpromoHls();
            if (webpromoBg) webpromoBg.style.display = 'block';
            kovaWebpromo.style.display = 'block';
            if (tBtn) tBtn.style.display = 'flex';
            kovaWebpromo.currentTime = 0;
            kovaWebpromo.play().catch(() => {});
          } else if (kovaWebpromo.paused) {
            kovaWebpromo.play().catch(() => {});
          } else {
            kovaWebpromo.pause();
          }
        }
        */

        // B. Vinyl Logic (Pass-through click)
        if (hit && hit.closest('.vinyl-container')) {
           const vc = hit.closest('.vinyl-container') as HTMLElement;
           vc.click();
        }

        // C. Footer Links (Pass-through click)
        if (hit) {
          const footerLink = hit.closest('.footer-link') as HTMLAnchorElement | null;
          const socialIcon = hit.closest('.social-icon') as HTMLAnchorElement | null;
          const link = footerLink || socialIcon;
          if (link && link.href) {
            if (link.target === '_blank') {
              window.open(link.href, '_blank', 'noopener');
            } else {
              window.location.href = link.href;
            }
          }
        }
      });

      // 7. STARFIELD ANIMATION (Panel 6)
      if (typeof (window as any).initStarfield === 'function') {
        (window as any).initStarfield('starfield', 'snap-container');
      }
    });
   </script>

  <!-- Theatre Lightbox — outside visual-stack so z-index is unrestricted -->
  <div id="webpromo-theatre" aria-modal="true" role="dialog" aria-label="Theatre mode">
    <button id="webpromo-theatre-close" aria-label="Close theatre mode">&#x2715;</button>
    <video id="kova-webpromo-theatre" playsinline preload="none"></video>
  </div>
  </body>
</html>